# Copy to .env.local and fill in. .env.local is gitignored - never commit it.
GEMINI_API_KEY=paste-your-key-here
GEMINI_PROVIDER=gemini

# Images: "free" uses FLUX via Pollinations (no key). Remove once Gemini/OpenAI image credits are set up.
IMAGE_PROVIDER=free
# OPENAI_API_KEY=sk-...        # optional: OpenAI gpt-image-1 for images

# Optional overrides (comma-separated = fallback order)
# TEXT_MODEL=gemini-3.5-flash,gemini-2.5-flash
# IMAGE_MODEL=gemini-3.1-flash-image-preview,gemini-2.5-flash-image

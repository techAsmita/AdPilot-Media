# Copy to .env.local and fill in. .env.local and .env are gitignored - never commit them.

# ---------------------------------------------------------------------------
# TEXT MODEL - set at least one key. OpenAI is used first when both are present;
# pin one with TEXT_PROVIDER=openai | gemini | vertex.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Comma-separated = fallback order, tried left to right.
OPENAI_TEXT_MODEL=gpt-4.1-mini,gpt-4.1-nano

# Google alternative (AI Studio key, or an "AQ." key for Vertex express mode)
# GEMINI_API_KEY=paste-your-key-here
# TEXT_MODEL=gemini-3.5-flash,gemini-2.5-flash
# TEXT_PROVIDER=openai

# ---------------------------------------------------------------------------
# IMAGE MODEL
# Unset  = Gemini -> OpenAI -> free, skipping any stage whose key is missing.
# openai = OpenAI, then free as a last resort.
# gemini = Gemini, then free.
# free   = FLUX via Pollinations only (no key, no cost).
# ---------------------------------------------------------------------------
IMAGE_PROVIDER=openai
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# low | medium | high (flare also accepts xhigh | max). Unset = the API default.
OPENAI_IMAGE_QUALITY=low
# Pins one size for every channel. Unset follows the pack's aspect ratio
# (1:1 -> 1024x1024, 16:9 -> 1536x1024, 4:5 -> 1024x1536).
OPENAI_IMAGE_SIZE=1024x1024
# png | jpeg | webp. Defaults to jpeg: measured ~127 KB vs ~1.8 MB for png at
# 1024x1024/low. The image travels as a base64 data URL through the stream, React
# state and localStorage, and saved runs drop images over ~900 KB.
OPENAI_IMAGE_FORMAT=jpeg
# IMAGE_MODEL=gemini-3.1-flash-image-preview,gemini-2.5-flash-image

# ---------------------------------------------------------------------------
# Research source
# ---------------------------------------------------------------------------
# CLIENT_URL=https://fde-client-company-demos.aaryanptl.chatgpt.site/adpilot-media

# ---------------------------------------------------------------------------
# Abuse / cost guardrails (app/api/*, lib/ratelimit.ts)
# Max billable agent runs per UTC day, counted per server instance. 0 disables.
# ---------------------------------------------------------------------------
DAILY_RUN_BUDGET=200

# Model-call budgets (lib/llm.ts)
# One deadline for the whole fallback chain, and a cap per attempt. Keep the
# chain deadline below the route maxDuration in app/api/agent/route.ts.
MODEL_DEADLINE_MS=120000
MODEL_ATTEMPT_MS=60000

# Public origin, used to resolve the OpenGraph image URL in share cards.
# Must be set at BUILD time: the page is prerendered, so the share-card URL is
# baked in by `next build`, not read at runtime. Vercel supplies VERCEL_URL.
# NEXT_PUBLIC_SITE_URL=https://adpilot-media.vercel.app
